# Fuente de la demostración. Crear ejemplo jugable genera la copia .level editable.
version: 1
id: entrada_piramide
catalogo: Assets/Levels/Examples/Generated/Catalog.asset
longitud_m: 2000

inicial:
  fondo: fondo.exterior
  ambientacion: ambiente.exterior
  musica: musica.exterior
  sonido_ambiental: sonido.ambiente

tramos:
  - id: exterior
    recurso: escenario.exterior
    inicio_s: 0
    fin_s: 300
    precargar_en: 0
    descargar_en: 2000
  - id: interior
    recurso: escenario.interior
    inicio_s: 300
    fin_s: 2000
    precargar_en: 120
    descargar_en: 2000 

eventos:
  - id: torreta_izquierda
    en: 100
    accion: crear
    recurso: enemigo.torreta
    tramo: exterior
    posicion: { s: 200, x: -12, y: 0 }
    parametros: { vida: 5   }

  

  - id: lanzador_rayos
    en: 0
    accion: crear
    recurso: enemigo.lanzadorRayos
    tramo: exterior
    posicion: { s: 200, x: 0, y: 0 }
    parametros: { vida: 8 }

  - id: muro_derecho
    en: 0
    accion: crear
    recurso: obstaculo.muro
    tramo: exterior
    posicion: { s: 170, x: 10, y: 0 }
    parametros: { vida: 10, dano: 10, duracion_s: 20 }

    #Oleada de enemigos seguidores
  #- id: perseguidora_1
  #  en: 170
  #  accion: crear
  #  recurso: enemigo.hostigador
  #  posicion: { s: 240, x: 30, y: 15 }
  #  parametros: { vida: 5 }

  #- id: perseguidora_2
  #  en: 170
  #  accion: crear
  #  recurso: enemigo.hostigador
  #  posicion: { s: 240, x: 20, y: -5 }
  #  parametros: { vida: 5 }

  #- id: perseguidora_3
  #  en: 170
  #  accion: crear
  #  recurso: enemigo.hostigador
  #  posicion: { s: 240, x: -15, y: 10 }
  #  parametros: { vida: 5 }
   
  - id: lanzador_rayos2
    en: 300
    accion: crear
    recurso: enemigo.lanzadorRayos
    tramo: interior
    posicion: { s: 800, x: 20, y: 0 }
    parametros: { vida: 8 }

  - id: lanzador_rayos3
    en: 300
    accion: crear
    recurso: enemigo.lanzadorRayos
    tramo: interior
    posicion: { s: 800, x: -20, y: 0 }
    parametros: { vida: 8 }

    
  - id: ambiente_interior
    en: 300
    accion: ambientacion
    recurso: ambiente.interior
    transicion_s: 3

  - id: fondo_interior
    en: 300
    accion: fondo
    recurso: fondo.interior
    transicion_s: 2

  - id: musica_interior
    en: 300
    accion: musica
    recurso: musica.interior
    transicion_s: 2

  - id: objeto_curacion1
    en: 300
    accion: crear
    recurso: objeto.reparacion
    posicion: { s: 400, x: -15, y: 10 }
    #parametros: { }

  - id: torreta_final
    en: 340
    accion: crear
    recurso: enemigo.torreta
    tramo: interior
    posicion: { s: 500, x: 0, y: 8 }
    parametros: { vida: 10 }

  - id: torreta_Rebelde
    en: 1100
    accion: crear
    recurso: enemigo.torreta
    tramo: interior
    posicion: { s: 1250, x: 0, y: 8 }
    parametros: { vida: 10 }

  - id: enemigo_futuro
    habilitado: false
    en: 1100
    accion: crear
    recurso: enemigo.guardian
    posicion: { s: 1200, x: 0, y: 0 }

  - id: salida
    en: 2000
    accion: finalizar
