# Fuente de la demostración. Crear ejemplo jugable genera la copia .level editable.
version: 1
id: entrada_piramide
catalogo: Assets/Levels/Examples/Generated/Catalog.asset
longitud_m: 8500

inicial:
  fondo: fondo.exterior
  ambientacion: ambiente.exterior
  musica: musica.exterior
  sonido_ambiental: sonido.ambiente

tramos:
  - id: exterior
    recurso: escenario.exterior
    inicio_s: 0
    fin_s: 2000
    precargar_en: 0
    descargar_en: 2200
  - id: interior
    recurso: escenario.interior
    inicio_s: 2000
    fin_s: 8500
    precargar_en: 1800
    descargar_en: 8500

eventos:
  - id: torreta_izquierda
    en: 2200
    accion: crear
    recurso: enemigo.torreta
    tramo: interior
    posicion: { s: 2580, x: -20, y: -8 }
    parametros: { vida: 4 }

  - id: lanzador_rayos
    en: 800
    accion: crear
    recurso: enemigo.lanzadorRayos
    tramo: exterior
    posicion: { s: 500, x: 10, y: 0 }
    parametros: { vida: 4 }

  - id: escenario.nave_destruida
    en: 400
    accion: crear
    recurso: escenario.nave_destruida
    tramo: exterior
    posicion: { s: 1500, x: 0, y: -10 }

  - id: escenario.pasillo_artilleros
    en: 2000
    accion: crear
    recurso: escenario.pasillo_artilleros
    tramo: interior
    posicion: { s: 3800, x: 0, y: -10 }

  - id: escenario.fortaleza
    en: 3500
    accion: crear
    recurso: escenario.fortaleza
    tramo: interior
    posicion: { s: 4598, x: 80, y: -20 }

  # Oleada de enemigos seguidores
  - id: perseguidora_1
    en: 2150
    accion: crear
    recurso: enemigo.hostigador
    posicion: { s: 2250, x: 30, y: 15 }
    parametros: { vida: 2 }

  - id: perseguidora_2
    en: 2150
    accion: crear
    recurso: enemigo.hostigador
    posicion: { s: 2250, x: 10, y: -5 }
