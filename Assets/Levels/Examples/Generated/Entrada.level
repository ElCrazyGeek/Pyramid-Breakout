    posicion: { s: 2250, x: -30, y: 10 }
    parametros: { vida: 4 }
    
  - id: lanzador_rayos2
    en: 1000
    accion: crear
    recurso: enemigo.lanzadorRayos
    tramo: exterior
    posicion: { s: 1700, x: 20, y: 0 }
    parametros: { vida: 4 }

  - id: lanzador_rayos3
    en: 1000
    accion: crear
    recurso: enemigo.lanzadorRayos
    tramo: exterior
    posicion: { s: 1700, x: -20, y: 0 }
    parametros: { vida: 4 }

  - id: ambiente_interior
    en: 0
    accion: ambientacion
    recurso: ambiente.interior
    transicion_s: 0

  - id: fondo_interior
    en: 0
    accion: fondo
    recurso: fondo.interior
    transicion_s: 2

  - id: musica_interior
    en: 0
    accion: musica
    recurso: musica.interior
    transicion_s: 2


