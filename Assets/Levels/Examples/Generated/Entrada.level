# Fuente de la demostración. Crear ejemplo jugable genera la copia .level editable.
version: 1
id: entrada_piramide
catalogo: Assets/Levels/Examples/Generated/Catalog.asset
longitud_m: 8500

inicial:
  fondo: fondo.exterior
  ambientacion: ambiente.exterior
  musica: musica.exterior
  sonido_ambiental: sonido.ambiente

tramos:
  - id: exterior
    recurso: escenario.exterior
    inicio_s: 0
    fin_s: 4800
    precargar_en: 0
    descargar_en: 5000
  - id: interior
    recurso: escenario.interior
    inicio_s: 4800
    fin_s: 8500
    precargar_en: 4400
    descargar_en: 8500

eventos:

  # --- TRAMO EXTERIOR (0 a 4900) ---
  - id: lanzador_rayos
    en: 800
    accion: crear
    recurso: enemigo.lanzadorRayos
    tramo: exterior
    posicion: { s: 500, x: 10, y: 0 }
    parametros: { vida: 4 }

  # Barco: inicia en 1500 y termina en 3044
  - id: escenario.nave_destruida
    en: 400
    accion: crear
    recurso: escenario.nave_destruida
    tramo: exterior
    posicion: { s: 1500, x: 0, y: -10 }

  - id: lanzador_rayos2
    en: 1000
    accion: crear
    recurso: enemigo.lanzadorRayos
    tramo: exterior
    posicion: { s: 1700, x: 20, y: 0 }
    parametros: { vida: 4 }

  - id: lanzador_rayos3
    en: 1000
    accion: crear
    recurso: enemigo.lanzadorRayos
    tramo: exterior
    posicion: { s: 1700, x: -20, y: 0 }
    parametros: { vida: 4 }

  # Oleada de enemigos seguidores en zona vacía (+1150)
  - id: perseguidora_1
    en: 3450
    accion: crear
    recurso: enemigo.hostigador
    posicion: { s: 3530, x: 10, y: 15 }
    parametros: { vida: 4 }

  - id: perseguidora_2
    en: 3450
    accion: crear
    recurso: enemigo.hostigador
    posicion: { s: 3530, x: -10, y: -5 }
    parametros: { vida: 4 }

  - id: perseguidora_3
    en: 3450
    accion: crear
    recurso: enemigo.hostigador
    posicion: { s: 3530, x: -30, y: 10 }
    parametros: { vida: 4 }

  - id: ambiente_interior
    en: 0
    accion: ambientacion
    recurso: ambiente.interior
    transicion_s: 0

  - id: fondo_interior
    en: 0
    accion: fondo
    recurso: fondo.interior
    transicion_s: 2

  - id: musica_interior
    en: 0
    accion: musica
    recurso: musica.interior
    transicion_s: 2

  # --- ESCENARIOS INTERIORES ---
  - id: escenario.pasillo_artilleros
    en: 4550
    accion: crear
    recurso: escenario.pasillo_artilleros
    tramo: interior
